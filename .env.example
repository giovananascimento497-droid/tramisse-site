# Copie para .env.local (em desenvolvimento) ou cadastre na Netlify (Project configuration → Environment variables).
# NUNCA coloque o token verdadeiro no repositório.

# Domínio do site (sitemap e retorno do Mercado Pago). Ex.: https://www.tramisse.com.br
NEXT_PUBLIC_SITE_URL=

# Mercado Pago: Access Token da sua aplicação (Suas integrações → Credenciais).
# Use primeiro o de TESTE (começa com TEST-) e depois o de produção (começa com APP_USR-).
# Sem token, a opção de pagar pelo Mercado Pago não aparece e o site continua só com o WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=

# Melhor Envio (frete dos Correios PAC/SEDEX calculado pelo CEP): token gerado no painel do Melhor Envio
# com permissão de calcular frete (shipping-calculate). Sem token, a opção Correios não aparece no checkout.
MELHORENVIO_TOKEN=
# "sandbox" para testar com um token do ambiente de testes (sandbox.melhorenvio.com.br); vazio = produção.
MELHORENVIO_AMBIENTE=
# Opcional: e-mail técnico de contato exigido pelo Melhor Envio no cabeçalho das chamadas.
MELHORENVIO_CONTATO=

# Painel /admin
# Senha do painel (pelo menos 8 caracteres). Trocar a senha desconecta quem estiver logado.
ADMIN_SENHA=
# Token do GitHub (fine-grained) só para o repositório do site, com permissão "Contents: Read and write".
# O painel salva as alterações com um commit e a Netlify publica o site de novo sozinha.
GITHUB_TOKEN=
# Opcionais (já têm valor padrão): repositório e branch publicados.
GITHUB_REPO=giovananascimento497-droid/tramisse-site
GITHUB_BRANCH=claude/determined-lovelace-33qqkg
