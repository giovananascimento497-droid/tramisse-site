# Copie para .env.local (em desenvolvimento) ou cadastre na Netlify (Project configuration → Environment variables).
# NUNCA coloque o token verdadeiro no repositório.

# Domínio do site (sitemap e retorno do Mercado Pago). Ex.: https://www.tramisse.com.br
NEXT_PUBLIC_SITE_URL=

# Mercado Pago: Access Token da sua aplicação (Suas integrações → Credenciais).
# Use primeiro o de TESTE (começa com TEST-) e depois o de produção (começa com APP_USR-).
# Sem token, a opção de pagar pelo Mercado Pago não aparece e o site continua só com o WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=
